# SurfConext Authentication Configuration
# Copy this file to .env and fill in your actual values

# Get these from your SurfConext registration
SURFCONEXT_CLIENT_ID=your-client-id-here
SURFCONEXT_CLIENT_SECRET=your-client-secret-here

# Optional: Override default authority (defaults to test environment)
# SURFCONEXT_AUTHORITY=https://connect.surfconext.nl
